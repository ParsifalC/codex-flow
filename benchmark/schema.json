{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codex-flow benchmark strategy run",
  "type": "object",
  "required": [
    "schema_version", "task_id", "task_class", "strategy_id", "strategy",
    "reasoning_policy", "model", "reasoning_effort", "worker_model", "worker_reasoning_effort",
    "passed", "first_passed", "input_tokens", "cached_input_tokens",
    "output_tokens", "model_usage", "repair_cycles", "review_cycles"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "task_id": {"type": "string", "minLength": 1},
    "task_class": {"enum": ["routine", "complex", "critical"]},
    "strategy_id": {"type": "string", "minLength": 1},
    "strategy": {"enum": ["direct", "flow"]},
    "reasoning_policy": {"enum": ["fixed", "adaptive"]},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"enum": ["high", "xhigh", "max"]},
    "worker_model": {"type": ["string", "null"]},
    "worker_reasoning_effort": {"type": ["string", "null"], "enum": ["high", "xhigh", "max", null]},
    "passed": {"type": "boolean"},
    "first_passed": {"type": "boolean"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "cached_input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "model_usage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "model", "reasoning_effort", "calls", "input_tokens", "cached_input_tokens", "output_tokens"],
        "properties": {
          "role": {"enum": ["direct", "parent", "worker"]},
          "model": {"type": "string", "minLength": 1},
          "reasoning_effort": {"enum": ["high", "xhigh", "max"]},
          "calls": {"type": "integer", "minimum": 1},
          "input_tokens": {"type": "integer", "minimum": 0},
          "cached_input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "repair_cycles": {"type": "integer", "minimum": 0},
    "review_cycles": {"type": "integer", "minimum": 0},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "source_commit": {"type": "string", "minLength": 1},
    "repetition": {"type": "integer", "minimum": 1},
    "codex_exit_code": {"type": "integer"},
    "verification_excerpt": {"type": "string"},
    "diagnostic_excerpt": {"type": "string"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"strategy": {"const": "direct"}}},
      "then": {
        "properties": {
          "reasoning_policy": {"const": "fixed"},
          "worker_model": {"type": "null"},
          "worker_reasoning_effort": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"strategy": {"const": "flow"}}},
      "then": {
        "properties": {
          "worker_model": {"type": "string", "minLength": 1},
          "worker_reasoning_effort": {"enum": ["high", "xhigh", "max"]}
        }
      }
    }
  ],
  "additionalProperties": false
}
