#!/usr/bin/env bash
set -uo pipefail

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CONFIG="$CODEX_HOME/config.toml"
POLICY="$CODEX_HOME/codex-flow.toml"
FAILED=0

ok() { printf '✓ %s\n' "$1"; }
warn() { printf '! %s\n' "$1"; }
fail() { printf '✗ %s\n' "$1"; FAILED=1; }

printf 'codex-flow doctor\n\n'

if command -v codex >/dev/null 2>&1; then
  VERSION="$(codex --version 2>/dev/null || true)"
  ok "Codex CLI found${VERSION:+: $VERSION}"
else
  fail "Codex CLI not found in PATH"
fi

[[ -f "$CONFIG" ]] && ok "config.toml found" || fail "missing $CONFIG"
[[ -f "$POLICY" ]] && ok "codex-flow policy found" || fail "missing $POLICY"
[[ -f "$CODEX_HOME/agents/worker-explorer.toml" ]] && ok "worker-explorer installed" || fail "worker-explorer missing"
[[ -f "$CODEX_HOME/agents/worker-implementer.toml" ]] && ok "worker-implementer installed" || fail "worker-implementer missing"
[[ -f "$CODEX_HOME/skills/cost-aware-development/SKILL.md" ]] && ok "cost-aware-development skill installed" || fail "cost-aware-development skill missing"

if [[ -f "$POLICY" ]]; then
  MIN_EFFORT="$(grep -E '^min_reasoning_effort\s*=' "$POLICY" | head -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')"
  MODEL_POLICY="$(grep -E '^model_policy\s*=' "$POLICY" | head -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')"
  WORKER_MODEL="$(grep -E '^model\s*=' "$POLICY" | tail -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')"
  WORKER_EFFORT="$(grep -E '^reasoning_effort\s*=' "$POLICY" | tail -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')"

  case "$MIN_EFFORT" in
    high|xhigh|max) ok "parent minimum reasoning is $MIN_EFFORT" ;;
    *) warn "parent minimum reasoning is '$MIN_EFFORT'; high or above is recommended" ;;
  esac
  ok "parent model policy: ${MODEL_POLICY:-unknown}"
  ok "worker policy: ${WORKER_MODEL:-unknown} / ${WORKER_EFFORT:-unknown}"
fi

if [[ -f "$CONFIG" && -f "$POLICY" ]]; then
  grep -Fq "default_subagent_model = \"${WORKER_MODEL}\"" "$CONFIG" \
    && ok "Codex subagent model matches policy" \
    || fail "Codex default_subagent_model does not match policy"
  grep -Fq "default_subagent_reasoning_effort = \"${WORKER_EFFORT}\"" "$CONFIG" \
    && ok "Codex subagent reasoning matches policy" \
    || fail "Codex default_subagent_reasoning_effort does not match policy"
fi

printf '\n'
if [[ "$FAILED" -eq 0 ]]; then
  printf 'Installation looks ready. Parent eligibility is policy-based, not tied to a fixed model slug.\n'
  exit 0
fi

printf 'One or more required checks failed. Re-run the installer, then restart Codex.\n'
exit 1
