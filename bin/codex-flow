#!/usr/bin/env bash
set -euo pipefail

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
STATE_DIR="$CODEX_HOME/codex-flow"
SOURCE_FILE="$STATE_DIR/source"
POLICY="$CODEX_HOME/codex-flow.toml"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SELF_DIR/.." && pwd)"

source_dir() {
  [[ -f "$SOURCE_FILE" ]] || { printf 'codex-flow: missing source metadata; reinstall codex-flow\n' >&2; exit 1; }
  local dir; dir="$(cat "$SOURCE_FILE")"
  [[ -d "$dir" ]] || { printf 'codex-flow: source checkout no longer exists: %s\n' "$dir" >&2; exit 1; }
  printf '%s\n' "$dir"
}

script_path() {
  local name="$1"
  local state_candidate="$STATE_DIR/$name"
  local repo_candidate="$REPO_ROOT/scripts/$name"
  if [[ -f "$state_candidate" ]]; then printf '%s\n' "$state_candidate"; return; fi
  if [[ -f "$repo_candidate" ]]; then printf '%s\n' "$repo_candidate"; return; fi
  local src=""; src="$(source_dir 2>/dev/null || true)"
  [[ -n "$src" && -f "$src/scripts/$name" ]] && { printf '%s\n' "$src/scripts/$name"; return; }
  return 1
}

LOCALIZATION="$(script_path localization.py 2>/dev/null || true)"
UI_LANG="en"
if [[ -n "$LOCALIZATION" ]] && command -v python3 >/dev/null 2>&1; then
  UI_LANG="$(python3 "$LOCALIZATION" --policy "$POLICY" --resolved 2>/dev/null || echo en)"
fi
cf_t() { if [[ "$UI_LANG" == "zh" ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }
fail() { printf 'codex-flow: %s\n' "$*" >&2; exit 1; }

read_policy_value() {
  local section="$1" key="$2" file="$3"
  awk -v section="[$section]" -v key="$key" '
    $0 == section { in_section=1; next }
    /^\[/ { in_section=0 }
    in_section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); sub(/[[:space:]]+#.*$/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (value ~ /^".*"$/) { sub(/^"/, "", value); sub(/"$/, "", value) }
      print value; exit
    }
  ' "$file"
}

if [[ $# -eq 0 ]]; then
  if [[ -t 0 && -t 1 && "${TERM:-}" != "dumb" ]]; then
    menu_script="$(script_path menu.py 2>/dev/null || true)"
    [[ -f "$menu_script" ]] && exec python3 "$menu_script"
  fi
  set -- help
fi

cmd="${1:-help}"
case "$cmd" in
  status|help|-h|--help)
    ui_script="$(script_path ui.py 2>/dev/null || true)"
    [[ -f "$ui_script" ]] || fail "$(cf_t 'localized UI helper is missing; reinstall codex-flow' '本地化 UI 组件缺失，请重新安装 codex-flow')"
    [[ "$cmd" == "status" ]] && exec python3 "$ui_script" status
    exec python3 "$ui_script" help
    ;;
  language)
    shift
    ui_script="$(script_path ui.py 2>/dev/null || true)"
    [[ -f "$ui_script" ]] || fail "$(cf_t 'localized UI helper is missing; reinstall codex-flow' '本地化 UI 组件缺失，请重新安装 codex-flow')"
    exec python3 "$ui_script" language "$@"
    ;;
  usage)
    shift
    telemetry_script="$(script_path telemetry.py 2>/dev/null || true)"
    [[ -f "$telemetry_script" ]] || fail "$(cf_t 'telemetry collector not installed; reinstall codex-flow' '遥测组件未安装，请重新安装 codex-flow')"
    [[ $# -eq 0 ]] && set -- last
    exec python3 "$telemetry_script" "$@"
    ;;
  benchmark-local)
    shift; exec python3 "$(source_dir)/scripts/benchmark-local.py" "$@" ;;
  benchmark-corpus)
    shift
    src="$(source_dir)"; profile="${1:-quick}"
    [[ "$profile" == "quick" || "$profile" == "full" ]] || fail "benchmark-corpus profile must be quick or full"
    [[ $# -gt 0 ]] && shift
    output_root="${1:-$PWD/.codex-flow-benchmark}"; mkdir -p "$output_root"
    exec python3 "$src/scripts/materialize-corpus.py" --corpus "$src/benchmark/corpus.json" --profiles "$src/benchmark/profiles.json" --profile "$profile" --output-dir "$output_root/corpus" --manifest "$output_root/manifest.json"
    ;;
  benchmark)
    shift; exec python3 "$(source_dir)/scripts/run-benchmark.py" "$@" ;;
  benchmark-analyze)
    shift; exec python3 "$(source_dir)/scripts/analyze-benchmark.py" "$@" ;;
  doctor)
    doctor_script="$(script_path doctor.py 2>/dev/null || true)"
    [[ -f "$doctor_script" ]] || fail "$(cf_t 'doctor helper is missing; reinstall codex-flow' '诊断组件缺失，请重新安装 codex-flow')"
    exec python3 "$doctor_script"
    ;;
  uninstall)
    exec bash "$(source_dir)/scripts/uninstall" ;;
  update)
    src="$(source_dir)"
    [[ -d "$src/.git" ]] || fail "$(cf_t 'update requires the original git checkout' '更新需要原始 Git checkout')"
    command -v git >/dev/null 2>&1 || fail "$(cf_t 'git is required for update' '更新需要 git')"
    [[ -f "$POLICY" ]] || fail "$(cf_t 'missing policy; reinstall codex-flow' '策略文件缺失，请重新安装 codex-flow')"

    parent_policy="$(read_policy_value parent model_policy "$POLICY")"
    parent_model="$(read_policy_value parent min_model "$POLICY")"
    parent_effort="$(read_policy_value parent min_reasoning_effort "$POLICY")"
    worker_policy="$(read_policy_value worker model_policy "$POLICY")"
    worker_model="$(read_policy_value worker model "$POLICY")"
    worker_effort="$(read_policy_value worker min_reasoning_effort "$POLICY")"
    max_threads="$(read_policy_value runtime max_concurrent_threads "$POLICY")"
    repair_cycles="$(read_policy_value runtime max_repair_cycles "$POLICY")"
    telemetry_enabled="$(read_policy_value telemetry enabled "$POLICY")"; [[ -n "$telemetry_enabled" ]] || telemetry_enabled=true
    telemetry_notifications="$(read_policy_value telemetry notifications "$POLICY")"; [[ -n "$telemetry_notifications" ]] || telemetry_notifications=true
    telemetry_retention_days="$(read_policy_value telemetry retention_days "$POLICY")"; [[ -n "$telemetry_retention_days" ]] || telemetry_retention_days=30

    before="$(cat "$src/VERSION" 2>/dev/null || echo unknown)"
    curr_branch="$(git -C "$src" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
    curr_remote="$(git -C "$src" config --get "branch.$curr_branch.remote" 2>/dev/null || echo "origin")"
    if [[ -n "$curr_branch" && "$curr_branch" != "HEAD" ]]; then
      git -C "$src" pull --ff-only "$curr_remote" "$curr_branch" 2>/dev/null || git -C "$src" pull --ff-only
    else
      git -C "$src" pull --ff-only
    fi
    after="$(cat "$src/VERSION" 2>/dev/null || echo unknown)"

    CODEX_FLOW_PARENT_MODEL_POLICY="$parent_policy" CODEX_FLOW_PARENT_MIN_MODEL="$parent_model" CODEX_FLOW_PARENT_MIN_EFFORT="$parent_effort" \
    CODEX_FLOW_WORKER_MODEL_POLICY="$worker_policy" CODEX_FLOW_WORKER_MODEL="$worker_model" CODEX_FLOW_WORKER_MIN_EFFORT="$worker_effort" \
    CODEX_FLOW_MAX_THREADS="$max_threads" CODEX_FLOW_MAX_REPAIR_CYCLES="$repair_cycles" CODEX_FLOW_TELEMETRY_ENABLED="$telemetry_enabled" CODEX_FLOW_TELEMETRY_NOTIFICATIONS="$telemetry_notifications" CODEX_FLOW_TELEMETRY_RETENTION_DAYS="$telemetry_retention_days" \
      bash "$src/install.sh"

    printf '\n✨ %s\n' "$(cf_t "Updated codex-flow $before -> $after" "codex-flow 已更新 $before -> $after")"
    exec python3 "$src/scripts/doctor.py"
    ;;
  overlay)
    shift
    src="$(source_dir 2>/dev/null || pwd)"
    overlay_bin="$STATE_DIR/bin/FlowPilot"
    [[ -x "$overlay_bin" ]] || overlay_bin="$STATE_DIR/bin/codex-flow-overlay"
    [[ -x "$overlay_bin" ]] || overlay_bin="$src/apps/macos-overlay/bin/FlowPilot"
    [[ -x "$overlay_bin" ]] || overlay_bin="$src/apps/macos-overlay/bin/codex-flow-overlay"
    [[ -x "$overlay_bin" ]] || fail "$(cf_t 'FlowPilot native overlay is not built. Run: bash apps/macos-overlay/build.sh' 'FlowPilot 原生悬浮窗尚未编译。请执行：bash apps/macos-overlay/build.sh')"
    sub="${1:-toggle}"
    case "$sub" in
      start|restart)
        "$overlay_bin" stop >/dev/null 2>&1 || true
        pkill -f "FlowPilot.*start|codex-flow-overlay.*start|bin/FlowPilot" 2>/dev/null || true
        sleep 0.2
        nohup "$overlay_bin" start >/dev/null 2>&1 &
        printf '%s\n' "$(cf_t '🚀 Launched FlowPilot in background.' '🚀 FlowPilot 已在后台启动。')"
        ;;
      *) exec "$overlay_bin" "$@" ;;
    esac
    ;;
  *) fail "$(cf_t "unknown command: $cmd" "未知命令：$cmd")" ;;
esac
