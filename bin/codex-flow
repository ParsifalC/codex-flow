#!/usr/bin/env bash
set -euo pipefail

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
STATE_DIR="$CODEX_HOME/codex-flow"
SOURCE_FILE="$STATE_DIR/source"
POLICY="$CODEX_HOME/codex-flow.toml"

fail() { printf 'codex-flow: %s\n' "$*" >&2; exit 1; }
source_dir() {
  [[ -f "$SOURCE_FILE" ]] || fail "missing source metadata; reinstall codex-flow"
  local dir
  dir="$(cat "$SOURCE_FILE")"
  [[ -d "$dir" ]] || fail "source checkout no longer exists: $dir"
  printf '%s\n' "$dir"
}
read_policy_value() {
  local section="$1" key="$2" file="$3"
  awk -v section="[$section]" -v key="$key" '
    $0 == section { in_section=1; next }
    /^\[/ { in_section=0 }
    in_section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); sub(/[[:space:]]+#.*$/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (value ~ /^".*"$/) { sub(/^"/, "", value); sub(/"$/, "", value) }
      print value; exit
    }
  ' "$file"
}

cmd="${1:-help}"
case "$cmd" in
  status)
    src="$(source_dir)"
    installed="$(cat "$STATE_DIR/version" 2>/dev/null || echo unknown)"
    available="$(cat "$src/VERSION" 2>/dev/null || echo unknown)"

    if [[ -t 1 && "${NO_COLOR:-}" != "1" && "${TERM:-}" != "dumb" ]]; then
      C_BOLD=$'\033[1m'
      C_DIM=$'\033[2m'
      C_GREEN=$'\033[32m'
      C_CYAN=$'\033[36m'
      C_RESET=$'\033[0m'
    else
      C_BOLD=""
      C_DIM=""
      C_GREEN=""
      C_CYAN=""
      C_RESET=""
    fi

    display_path() {
      local p="$1"
      if [[ -n "${HOME:-}" && "$p" == "$HOME"* ]]; then
        printf '~%s' "${p#$HOME}"
      else
        printf '%s' "$p"
      fi
    }

    disp_src="$(display_path "$src")"

    box_line() {
      local content="$1"
      local width=68
      local plain
      plain="$(printf '%s' "$content" | sed -E 's/\x1b\[[0-9;]*m//g')"
      local len=${#plain}
      local pad=$((width - len))
      if (( pad < 0 )); then pad=0; fi
      printf '  %s│%s  %s%*s %s│%s\n' "$C_DIM" "$C_RESET" "$content" "$pad" "" "$C_DIM" "$C_RESET"
    }

    printf '\n%s📦 codex-flow status%s\n\n' "$C_BOLD" "$C_RESET"
    printf '  %s╭─ Version & Paths ─────────────────────────────────────────────────╮%s\n' "$C_DIM" "$C_RESET"
    box_line "${C_BOLD}• Installed:${C_RESET}   v${installed}"
    box_line "${C_BOLD}• Checkout:${C_RESET}    ${disp_src} ${C_DIM}(v${available})${C_RESET}"
    box_line "${C_BOLD}• Skill:${C_RESET}       FlowPilot ${C_DIM}(flow-pilot)${C_RESET}"
    if [[ -f "$POLICY" ]]; then
      p_policy="$(read_policy_value parent model_policy "$POLICY")"
      p_effort="$(read_policy_value parent min_reasoning_effort "$POLICY")"
      w_model="$(read_policy_value worker resolved_model "$POLICY")"
      w_effort="$(read_policy_value worker min_reasoning_effort "$POLICY")"
      t_enabled="$(read_policy_value telemetry enabled "$POLICY")"

      printf '  %s├─ Model Routing ───────────────────────────────────────────────────┤%s\n' "$C_DIM" "$C_RESET"
      box_line "${C_BOLD}• Parent:${C_RESET}      ${p_policy} ${C_DIM}(min effort: ${p_effort})${C_RESET}"
      box_line "${C_BOLD}• Worker:${C_RESET}      ${w_model} ${C_DIM}(min effort: ${w_effort})${C_RESET}"
      if [[ "$t_enabled" == "true" ]]; then
        box_line "${C_BOLD}• Telemetry:${C_RESET}   ${C_GREEN}● enabled${C_RESET}"
      else
        box_line "${C_BOLD}• Telemetry:${C_RESET}   ${C_DIM}○ disabled${C_RESET}"
      fi
    fi
    printf '  %s╰───────────────────────────────────────────────────────────────────╯%s\n\n' "$C_DIM" "$C_RESET"
    ;;
  usage)
    shift
    [[ -f "$STATE_DIR/telemetry.py" ]] || fail "telemetry collector not installed; reinstall codex-flow"
    case "${1:-last}" in
      last) shift || true; exec python3 "$STATE_DIR/telemetry.py" last "$@" ;;
      *) fail "usage supports: last [--json]" ;;
    esac
    ;;
  benchmark-local)
    shift; exec python3 "$(source_dir)/scripts/benchmark-local.py" "$@" ;;
  benchmark-corpus)
    shift
    src="$(source_dir)"; profile="${1:-quick}"
    [[ "$profile" == "quick" || "$profile" == "full" ]] || fail "benchmark-corpus profile must be quick or full"
    [[ $# -gt 0 ]] && shift
    output_root="${1:-$PWD/.codex-flow-benchmark}"; mkdir -p "$output_root"
    exec python3 "$src/scripts/materialize-corpus.py" --corpus "$src/benchmark/corpus.json" --profiles "$src/benchmark/profiles.json" --profile "$profile" --output-dir "$output_root/corpus" --manifest "$output_root/manifest.json"
    ;;
  benchmark)
    shift; exec python3 "$(source_dir)/scripts/run-benchmark.py" "$@" ;;
  benchmark-analyze)
    shift; exec python3 "$(source_dir)/scripts/analyze-benchmark.py" "$@" ;;
  doctor)
    exec bash "$(source_dir)/scripts/doctor" ;;
  uninstall)
    exec bash "$(source_dir)/scripts/uninstall" ;;
  update)
    src="$(source_dir)"
    [[ -d "$src/.git" ]] || fail "update requires the original git checkout"
    command -v git >/dev/null 2>&1 || fail "git is required for update"
    [[ -f "$POLICY" ]] || fail "missing policy; reinstall codex-flow"

    parent_policy="$(read_policy_value parent model_policy "$POLICY")"
    parent_model="$(read_policy_value parent min_model "$POLICY")"
    parent_effort="$(read_policy_value parent min_reasoning_effort "$POLICY")"
    worker_policy="$(read_policy_value worker model_policy "$POLICY")"
    worker_model="$(read_policy_value worker model "$POLICY")"
    worker_effort="$(read_policy_value worker min_reasoning_effort "$POLICY")"
    max_threads="$(read_policy_value runtime max_concurrent_threads "$POLICY")"
    repair_cycles="$(read_policy_value runtime max_repair_cycles "$POLICY")"
    telemetry_enabled="$(read_policy_value telemetry enabled "$POLICY")"
    [[ -n "$telemetry_enabled" ]] || telemetry_enabled=true

    before="$(cat "$src/VERSION" 2>/dev/null || echo unknown)"
    git -C "$src" pull --ff-only
    after="$(cat "$src/VERSION" 2>/dev/null || echo unknown)"

    CODEX_FLOW_PARENT_MODEL_POLICY="$parent_policy" CODEX_FLOW_PARENT_MIN_MODEL="$parent_model" CODEX_FLOW_PARENT_MIN_EFFORT="$parent_effort" \
    CODEX_FLOW_WORKER_MODEL_POLICY="$worker_policy" CODEX_FLOW_WORKER_MODEL="$worker_model" CODEX_FLOW_WORKER_MIN_EFFORT="$worker_effort" \
    CODEX_FLOW_MAX_THREADS="$max_threads" CODEX_FLOW_MAX_REPAIR_CYCLES="$repair_cycles" CODEX_FLOW_TELEMETRY_ENABLED="$telemetry_enabled" \
      bash "$src/install.sh"

    printf '\n✨ Updated codex-flow %s -> %s\n' "$before" "$after"
    bash "$src/scripts/doctor"
    ;;
  help|-h|--help)
    if [[ -t 1 && "${NO_COLOR:-}" != "1" && "${TERM:-}" != "dumb" ]]; then
      C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_CYAN=$'\033[36m'; C_RESET=$'\033[0m'
    else
      C_BOLD=""; C_DIM=""; C_CYAN=""; C_RESET=""
    fi
    cat <<EOF

${C_BOLD}Usage:${C_RESET} codex-flow <command> [options]

  ${C_BOLD}Core Commands${C_RESET}
    ${C_CYAN}status${C_RESET}              Show installed version and effective FlowPilot policy
    ${C_CYAN}update${C_RESET}              Pull checkout, preserve policy, refresh recommendations
    ${C_CYAN}doctor${C_RESET}              Verify installation, routing, and telemetry wiring
    ${C_CYAN}usage last${C_RESET}          Show the last task telemetry summary (--json for raw)

  ${C_BOLD}Benchmark Commands${C_RESET}
    ${C_CYAN}benchmark-local${C_RESET}     Run built-in benchmark via local Codex session
    ${C_CYAN}benchmark-corpus${C_RESET}    Materialize corpus without calling any model
    ${C_CYAN}benchmark${C_RESET}           Run a reproducible Codex benchmark manifest
    ${C_CYAN}benchmark-analyze${C_RESET}   Analyze benchmark JSONL with quality-first routing

  ${C_BOLD}Maintenance${C_RESET}
    ${C_CYAN}uninstall${C_RESET}           Remove codex-flow-managed files and hooks

  ${C_DIM}💡 Quick Start:${C_RESET}
    Run ${C_CYAN}codex-flow benchmark-local quick${C_RESET} for your first validation run.

EOF
    ;;
  *) fail "unknown command: $cmd" ;;
esac
